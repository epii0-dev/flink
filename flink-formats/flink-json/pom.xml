<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.apache.flink</groupId>
		<artifactId>flink-formats</artifactId>
		<version>2.3.0</version>
	</parent>

	<groupId>org.epii0</groupId>
	<artifactId>flink-json</artifactId>
	<version>2.3.0-epii0.1</version>
	<!-- The upstream module name is intentionally kept verbatim: it is interpolated
		into the generated META-INF/NOTICE together with the ASF copyright line.
		The derivative is identified by groupId/version, description, SCM and
		manifest vendor entries instead of renaming ASF-copyrighted content. -->
	<name>Flink : Formats : Json</name>
	<description>
		Epii0-maintained patch release of the Apache Flink 2.3.0 flink-json module
		(Apache License 2.0). Changes versus upstream 2.3.0: exceptions thrown by the
		downstream Collector propagate unchanged instead of being misclassified or
		swallowed as parse errors, malformed records ignored via ignore-parse-errors
		are not emitted to the Collector as null rows, and the raw-input preview
		embedded in JSON parse diagnostics and debug logs is byte-bounded.
		This is not an official Apache Flink release.
	</description>
	<url>https://github.com/epii0-dev/flink</url>

	<scm>
		<connection>scm:git:https://github.com/epii0-dev/flink.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/epii0-dev/flink.git</developerConnection>
		<url>https://github.com/epii0-dev/flink</url>
		<tag>epii0-json-2.3.0-epii0.1-rc2</tag>
	</scm>

	<developers>
		<developer>
			<id>epii0-dev</id>
			<name>Epii0</name>
			<email>331247313+epii0-dev@users.noreply.github.com</email>
			<organization>Epii0</organization>
			<organizationUrl>https://github.com/epii0-dev</organizationUrl>
		</developer>
	</developers>

	<packaging>jar</packaging>

	<properties>
		<!-- Version of the official org.apache.flink artifacts this module depends on. -->
		<flink.upstream.version>2.3.0</flink.upstream.version>
		<!-- Match the upstream release bytecode baseline (major 55) instead of the
			developer default 17; the upstream release profile cannot be activated here
			because it also enables artifact signing. -->
		<target.java.version>11</target.java.version>
		<surefire.module.config><!--
			chill ArraysAsListSerializer
			-->--add-opens=java.base/java.util=ALL-UNNAMED
		</surefire.module.config>
	</properties>

	<dependencies>

		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-format-common</artifactId>
			<version>${flink.upstream.version}</version>
			<optional>${flink.markBundledAsOptional}</optional>
		</dependency>

		<!-- core dependencies -->

		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-shaded-jackson</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-core</artifactId>
			<version>${flink.upstream.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- Table ecosystem and filesystem connector -->

		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-common</artifactId>
			<version>${flink.upstream.version}</version>
			<scope>provided</scope>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-connector-files</artifactId>
			<version>${flink.upstream.version}</version>
			<scope>provided</scope>
			<optional>true</optional>
		</dependency>

		<!-- test dependencies -->

		<!-- JSON table descriptor testing -->
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-common</artifactId>
			<version>${flink.upstream.version}</version>
			<scope>test</scope>
			<type>test-jar</type>
		</dependency>

		<!-- JSON RowData schema test dependency -->
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-planner_${scala.binary.version}</artifactId>
			<version>${flink.upstream.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- Json filesystem format factory ITCase test dependency -->
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-api-scala-bridge_${scala.binary.version}</artifactId>
			<version>${flink.upstream.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-planner_${scala.binary.version}</artifactId>
			<version>${flink.upstream.version}</version>
			<scope>test</scope>
			<type>test-jar</type>
		</dependency>

		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-connector-datagen</artifactId>
			<version>${flink.upstream.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>

		<!-- test utils dependency -->
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-connector-test-utils</artifactId>
			<version>${flink.upstream.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-test-utils</artifactId>
			<version>${flink.upstream.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- JSON RowData schema test dependency -->
		<dependency>
			<groupId>org.scala-lang</groupId>
			<artifactId>scala-compiler</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- ArchUnit test dependencies -->

		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-architecture-tests-test</artifactId>
			<version>${flink.upstream.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<!-- The root dependencyManagement expresses these two versions as
				${project.version}, which resolves to this module's own epii0 version
				and would break resolution. Pin them to the official upstream release.
				All other org.apache.flink artifacts are either pinned directly below
				or carry their own versions transitively. -->
			<dependency>
				<groupId>org.apache.flink</groupId>
				<artifactId>flink-test-utils-junit</artifactId>
				<version>${flink.upstream.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.apache.flink</groupId>
				<artifactId>flink-architecture-tests-base</artifactId>
				<version>${flink.upstream.version}</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!-- The jar manifest defaults derive vendor from the ASF parent
				organization; identify the actual maintainer of this derivative
				instead, without touching the ASF-copyrighted NOTICE content.
				Built-By is overridden explicitly: the archiver default leaks the
				build machine's user.name, which must not appear in the published
				artifact. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifestEntries>
							<Built-By>Epii0</Built-By>
							<Implementation-Vendor>Epii0</Implementation-Vendor>
							<Implementation-Vendor-Id>org.epii0</Implementation-Vendor-Id>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
			<!-- Pin the japicmp plugin's own flink-annotations helper to the official
				release; the inherited ${project.version} would resolve to the epii0
				version. The compatibility baseline stays the official 2.2.0 artifact. -->
			<plugin>
				<groupId>com.github.siom79.japicmp</groupId>
				<artifactId>japicmp-maven-plugin</artifactId>
				<configuration>
					<dependencies combine.self="override">
						<dependency>
							<groupId>org.apache.flink</groupId>
							<artifactId>flink-annotations</artifactId>
							<version>${flink.upstream.version}</version>
						</dependency>
					</dependencies>
				</configuration>
			</plugin>
			<!-- Attach sources and javadoc like the upstream docs-and-source profile,
				but unconditionally so every build of this release module produces the
				full Central artifact set. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.2.1</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<configuration>
					<quiet>true</quiet>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<id>shade-flink</id>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<artifactSet>
								<includes>
									<include>org.apache.flink:flink-format-common</include>
								</includes>
							</artifactSet>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Manual Central publication only: activated explicitly by the release
			coordinator for the signed deploy step; unsigned preparation builds do
			not activate it. -->
		<profile>
			<id>epii0-central-release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.8</version>
						<configuration>
							<bestPractices>true</bestPractices>
						</configuration>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.11.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<autoPublish>false</autoPublish>
							<waitUntil>validated</waitUntil>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
